# Copy to .env.local (gitignored) for local work, or set these in the build
# environment. Every REACT_APP_* variable present at build time is inlined into
# main.js — see the warning below before setting the AWS ones.

# Where the admin API lives. Defaults to production if unset.
REACT_APP_API_BASE_URL=http://localhost:5200/admin

# --- Image uploads: pick ONE of the two paths ---
#
# A) Leave the AWS variables below EMPTY (recommended).
#    Uploads go through POST /admin/upload/presign and the credentials live only
#    in the API's own .env. Nothing secret reaches the browser.
#
# B) Set them, and the browser signs its own S3 uploads without the API.
#    !! REACT_APP_AWS_SECRET_ACCESS_KEY is written verbatim into main.js and
#    !! served to everyone who opens the CMS. It is a public value from that point
#    !! on. Only do this with an IAM user scoped to s3:PutObject on this one
#    !! bucket, and rotate it as you would any leaked key.
#
# Verify which path a build took:
#   grep -c "REACT_APP_AWS_SECRET" build/static/js/*.js
REACT_APP_AWS_ACCESS_KEY_ID=
REACT_APP_AWS_SECRET_ACCESS_KEY=
REACT_APP_AWS_REGION=ap-southeast-1
REACT_APP_AWS_S3_BUCKET=sstaging-localbalivilla
REACT_APP_AWS_S3_PREFIX=lbv
